{
  "sourceLanguage": "en",
  "strings": {
    "Cycle ${group} with ${applicationName}": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "${group} mit ${applicationName} durchlaufen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorrer ${group} con ${applicationName}"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire défiler ${group} avec ${applicationName}"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "${applicationName}で${group}を巡回"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "${applicationName}에서 ${group} 순환"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "${applicationName} ile ${group} grubunda dolaş"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用${applicationName}循环切换${group}"
          }
        }
      }
    },
