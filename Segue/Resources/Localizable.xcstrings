    "Its shortcut will stop working. You can't undo this.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der zugehörige Kurzbefehl funktioniert dann nicht mehr. Dies kann nicht widerrufen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su atajo dejará de funcionar. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son raccourci cessera de fonctionner. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループのショートカットは機能しなくなります。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 단축키가 더 이상 작동하지 않습니다. 이 동작은 실행 취소할 수 없습니다."
          }
        },
        "tr": {
