    "Tap a modifier key on its own to switch. Holding it or pressing it with another key doesn't count.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe zum Wechseln eine Sondertaste allein an. Gedrückthalten oder Drücken zusammen mit einer anderen Taste zählt nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa una tecla de modificación sola para cambiar. Mantenerla pulsada o pulsarla junto con otra tecla no cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une touche de modification seule pour changer. La maintenir enfoncée ou l’utiliser avec une autre touche ne compte pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修飾キーを単独で押すと切り替わります。長押しや他のキーとの同時押しは対象外です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보조 키를 단독으로 탭하면 전환됩니다. 길게 누르거나 다른 키와 함께 누르는 것은 해당되지 않습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçiş yapmak için bir niteleyici tuşa tek başına dokunun. Basılı tutmak veya başka bir tuşla birlikte basmak sayılmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单独轻按修饰键即可切换。按住或与其他键一起按下不会触发。"
          }
        }
      }
    },
    "That group needs at least two input sources.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gruppe benötigt mindestens zwei Eingabequellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese grupo necesita al menos dos fuentes de entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce groupe doit contenir au moins deux sources de saisie."
          }
        },
        "ja": {
