            "state": "translated",
            "value": "そのグループには2つ以上の入力ソースが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 그룹에는 입력 소스가 두 개 이상 필요합니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
