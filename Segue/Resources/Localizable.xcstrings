            "state": "translated",
            "value": "¿Eliminar la regla para “%@”?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer la règle pour « %@ » ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”のルールを削除しますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ 규칙을 제거하겠습니까?"
          }
