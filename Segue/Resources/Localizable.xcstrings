{
  "sourceLanguage": "en",
  "strings": {
    "%@ %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ – %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@を%1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %1$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ – %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@%2$@"
          }
        }
      }
    },
    "%@ points to an older copy of Segue.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verweist auf eine ältere Kopie von Segue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ apunta a una copia anterior de Segue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pointe vers une ancienne copie de Segue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は古いSegueを参照しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 이전 Segue 사본을 가리킵니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, Segue’in eski bir kopyasını gösteriyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 指向旧版 Segue。"
          }
        }
      }
    },
    "A group cycles through several input sources with one shortcut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Gruppe wechselt mit einem Kurzbefehl reihum zwischen mehreren Eingabequellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un grupo recorre varias fuentes de entrada con un solo atajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un groupe fait défiler plusieurs sources de saisie avec un seul raccourci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループを使うと、1つのショートカットで複数の入力ソースを順に切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹은 하나의 단축키로 여러 입력 소스를 순환합니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grup, tek bir kestirmeyle birden fazla giriş kaynağı arasında dolaşır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "组可以用一个快捷键在多个输入法之间循环切换。"
          }
        }
      }
    },
