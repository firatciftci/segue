    "Modifier keys need Input Monitoring access in Privacy & Security.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Sondertasten ist Zugriff auf „Eingabeüberwachung“ unter „Datenschutz & Sicherheit“ erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas de modificación necesitan acceso a Monitorización de entrada en Privacidad y seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches de modification nécessitent l’accès à la surveillance de l’entrée dans Confidentialité et sécurité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修飾キーを使うには、“プライバシーとセキュリティ”で“入力監視”へのアクセスを許可する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보조 키를 사용하려면 개인정보 보호 및 보안에서 입력 모니터링 접근을 허용해야 합니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niteleyici tuşlar için Gizlilik ve Güvenlik’te Giriş İzleme erişimi gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修饰键需要在“隐私与安全性”中获得“输入监控”权限。"
          }
        }
      }
    },
    "Segue Settings.json": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue-Einstellungen.json"
          }
        },
        "es": {
