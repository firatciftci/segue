    "Importing “%@” replaces your current settings, groups, rules, and shortcuts in Segue.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Importieren von „%@“ werden deine aktuellen Einstellungen, Gruppen, Regeln und Kurzbefehle in Segue ersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al importar “%@”, se reemplazarán los ajustes, grupos, reglas y atajos actuales de Segue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importation de « %@ » remplace vos réglages, groupes, règles et raccourcis actuels dans Segue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”を読み込むと、Segueの現在の設定、グループ、ルール、ショートカットが置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ 파일을 가져오면 Segue의 현재 설정, 그룹, 규칙 및 단축키가 대치됩니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” dosyasını içe aktarmak, Segue’deki geçerli ayarlarınızın, gruplarınızın, kurallarınızın ve kestirmelerinizin yerini alır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入“%@”会替换 Segue 中当前的设置、组、规则和快捷键。"
          }
        }
      }
    },
