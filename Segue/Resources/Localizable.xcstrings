    "Add at least two input sources to cycle through.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge mindestens zwei Eingabequellen hinzu, zwischen denen gewechselt werden soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade al menos dos fuentes de entrada para recorrerlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez au moins deux sources de saisie à faire défiler."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替える入力ソースを2つ以上追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "순환할 입력 소스를 두 개 이상 추가하십시오."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolaşmak için en az iki giriş kaynağı ekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请至少添加两个输入法以便循环切换。"
          }
        }
      }
    },
    "Add or remove input sources in Keyboard Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Eingabequellen in den Tastatureinstellungen hinzu oder entferne sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade o elimina fuentes de entrada en los ajustes del teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez ou supprimez des sources de saisie dans les réglages du clavier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力ソースの追加と削除はキーボード設定で行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 설정에서 입력 소스를 추가하거나 제거하십시오."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş kaynaklarını Klavye Ayarları’nda ekleyin veya silin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在键盘设置中添加或移除输入法。"
          }
        }
      }
    },
