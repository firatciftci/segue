        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” kuralı silinsin mi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要移除“%@”的规则吗？"
          }
        }
      }
    },
    "Remove “%@” from “%@”?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ aus „%2$@“ entfernen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar “%1$@” de “%2$@”?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer « %1$@ » de « %2$@ » ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@”から“%1$@”を削除しますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%2$@’에서 ‘%1$@’을(를) 제거하겠습니까?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”, “%2$@” grubundan silinsin mi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要从“%2$@”中移除“%1$@”吗？"
          }
        }
      }
    },
