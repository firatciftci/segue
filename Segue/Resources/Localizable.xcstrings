    "Allow Segue in Privacy & Security > Automation to use website rules.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Segue unter „Datenschutz & Sicherheit“ > „Automation“, um Website-Regeln zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Segue en Privacidad y seguridad > Automatización para usar las reglas de sitios web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Segue dans Confidentialité et sécurité > Automatisation pour utiliser les règles de sites web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Webサイトのルールを使うには、“プライバシーとセキュリティ”>“オートメーション”でSegueを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 사이트 규칙을 사용하려면 개인정보 보호 및 보안 > 자동화에서 Segue를 허용하십시오."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Web sitesi kurallarını kullanmak için Gizlilik ve Güvenlik > Otomasyon’da Segue’e izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“隐私与安全性”>“自动化”中允许 Segue，以使用网站规则。"
          }
        }
      }
    },
    "Allow Segue in System Settings > General > Login Items & Extensions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Segue in „Systemeinstellungen“ > „Allgemein“ > „Anmeldeobjekte & Erweiterungen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Segue en Ajustes del Sistema > General > Ítems de inicio y extensiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Segue dans Réglages Système > Général > Ouverture et extensions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“システム設定”>“一般”>“ログイン項目と機能拡張”でSegueを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 > 일반 > 로그인 항목 및 확장 프로그램에서 Segue를 허용하십시오."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları > Genel > Giriş Öğeleri ve Uzantılar’da Segue’e izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置”>“通用”>“登录项与扩展”中允许 Segue。"
          }
        }
      }
    },
