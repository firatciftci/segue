    "Only one of these actions runs when you press the shortcut. Change it here or in Keyboard Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Drücken des Kurzbefehls wird nur eine dieser Aktionen ausgeführt. Ändere ihn hier oder in den Tastatureinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se ejecuta una de estas acciones al pulsar el atajo. Cámbialo aquí o en los ajustes del teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une seule de ces actions s’exécute lorsque vous appuyez sur le raccourci. Modifiez-le ici ou dans les réglages du clavier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを押しても、これらのアクションのうち1つしか実行されません。ここまたはキーボード設定で変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키를 누르면 이 동작 중 하나만 실행됩니다. 여기 또는 키보드 설정에서 변경하십시오."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeye bastığınızda bu eylemlerden yalnızca biri çalışır. Kestirmeyi burada veya Klavye Ayarları’nda değiştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下快捷键时只会执行其中一个操作。请在此处或键盘设置中更改。"
          }
        }
      }
    },
