    "If Segue is hidden from the menu bar, open it again from Finder or Spotlight to get back to these settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Segue in der Menüleiste ausgeblendet ist, öffne es erneut über den Finder oder Spotlight, um zu diesen Einstellungen zurückzukehren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Segue está oculto en la barra de menús, vuelve a abrirlo desde el Finder o Spotlight para volver a estos ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Segue est masqué dans la barre des menus, rouvrez-le depuis le Finder ou Spotlight pour revenir à ces réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Segueをメニューバーに表示しない場合は、FinderまたはSpotlightから再度開くとこの設定に戻れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue가 메뉴 막대에서 가려져 있는 경우, Finder 또는 Spotlight에서 다시 열면 이 설정으로 돌아올 수 있습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue menü çubuğunda gizliyse bu ayarlara dönmek için onu Finder’dan veya Spotlight’tan yeniden açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 Segue 已从菜单栏隐藏，请从“访达”或“聚焦”重新打开它以返回这些设置。"
          }
        }
      }
    },
