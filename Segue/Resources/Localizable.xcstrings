            "value": "Segue 设置.json"
          }
        }
      }
    },
    "Segue also opens segue:// links, so scripts and other apps can switch input sources, cycle groups, and open the quick switcher.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue öffnet auch segue://-Links, damit Skripte und andere Apps Eingabequellen wechseln, Gruppen durchlaufen und den Schnellwechsel öffnen können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue también abre enlaces segue://, para que los scripts y otras apps puedan cambiar de fuente de entrada, recorrer grupos y abrir el selector rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue ouvre aussi les liens segue://, pour que les scripts et autres apps puissent changer de source de saisie, parcourir les groupes et ouvrir le sélecteur rapide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Segueはsegue://リンクも開けるため、スクリプトや他のアプリから入力ソースの切り替え、グループの巡回、クイックスイッチャーの表示ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue는 segue:// 링크도 열 수 있어 스크립트와 다른 앱에서 입력 소스를 전환하고, 그룹을 순환하며, 빠른 전환을 열 수 있습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue segue:// bağlantılarını da açar; böylece betikler ve diğer uygulamalar giriş kaynağı değiştirebilir, gruplar arasında dolaşabilir ve hızlı geçişi açabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue 还能打开 segue:// 链接，脚本和其他 App 可借此切换输入法、循环切换组以及打开快速切换。"
          }
        }
      }
    },
    "Segue appears in the Dock and the app switcher while Settings is open.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue erscheint im Dock und im App-Umschalter, während die Einstellungen geöffnet sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue aparece en el Dock y en el selector de app mientras los Ajustes están abiertos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue apparaît dans le Dock et dans le sélecteur d’app lorsque les Réglages sont ouverts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定が開いている間、SegueはDockとアプリスイッチャーに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정이 열려 있는 동안 Segue가 Dock 및 앱 전환기에 표시됩니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar açıkken Segue, Dock’ta ve Uygulama Değiştirici’de görünür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置打开时，Segue 会显示在程序坞和 App 切换器中。"
          }
        }
      }
    },
    "Segue can't see modifier keys": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue kann keine Sondertasten erkennen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue no puede detectar las teclas de modificación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue ne peut pas détecter les touches de modification"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Segueは修飾キーを検出できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue가 보조 키를 감지할 수 없음"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue niteleyici tuşları göremiyor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue 无法检测修饰键"
          }
        }
      }
    },
    "Segue can't see which website is open in %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue kann nicht erkennen, welche Website in %@ geöffnet ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue no puede ver qué sitio web está abierto en %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue ne peut pas voir quel site web est ouvert dans %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Segueは%@で開いているWebサイトを確認できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue가 %@에서 열려 있는 웹 사이트를 확인할 수 없음"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue, %@ içinde hangi web sitesinin açık olduğunu göremiyor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue 无法查看 %@ 中打开的网站"
          }
        }
      }
    },
    "Segue couldn't read that settings file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue konnte diese Einstellungsdatei nicht lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue no ha podido leer ese archivo de ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue n’a pas pu lire ce fichier de réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Segueはその設定ファイルを読み込めませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue가 해당 설정 파일을 읽을 수 없습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue bu ayarlar dosyasını okuyamadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue 无法读取该设置文件。"
          }
        }
      }
    },
    "Segue will no longer switch input sources on this website.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue wechselt auf dieser Website die Eingabequelle nicht mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue dejará de cambiar la fuente de entrada en este sitio web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue ne changera plus de source de saisie sur ce site web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このWebサイトでは、Segueは入力ソースを切り替えなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 웹 사이트에서 Segue가 더 이상 입력 소스를 전환하지 않습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue bu web sitesinde artık giriş kaynağını değiştirmeyecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此网站上，Segue 将不再切换输入法。"
          }
        }
      }
    },
    "Segue will no longer switch input sources when you switch to this app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue wechselt die Eingabequelle nicht mehr, wenn du zu dieser App wechselst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue dejará de cambiar la fuente de entrada cuando cambies a esta app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue ne changera plus de source de saisie lorsque vous passerez à cette app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリに切り替えても、Segueは入力ソースを切り替えなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱으로 전환해도 Segue가 더 이상 입력 소스를 전환하지 않습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamaya geçtiğinizde Segue artık giriş kaynağını değiştirmeyecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换到此 App 时，Segue 将不再切换输入法。"
          }
        }
      }
    },
